{
  "rules": {
    ".read": false,
    ".write": false,

    "publicKeys": {
      ".read": "auth != null",
      "$uid": {
        "$keyId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['kty', 'crv', 'x', 'y']) && newData.child('kty').val() === 'EC' && newData.child('crv').val() === 'P-256' && newData.child('x').isString() && newData.child('y').isString() && $keyId.length > 0 && $keyId.length <= 64"
        }
      }
    },

    "chat": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$messageId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['uid', 'keyId', 'name', 'text', 'createdAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "keyId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000"
        },
        "photoUrl": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "signature": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
